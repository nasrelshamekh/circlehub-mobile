{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_NAME": "CircleHub"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_NAME": "CircleHub",
        "EXPO_PUBLIC_API_URL": "https://circlehub.runasp.net"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_NAME": "CircleHub",
        "EXPO_PUBLIC_API_URL": "https://circlehub.runasp.net"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
