{
  "expo": {
    "name": "CircleHub",
    "slug": "circlehub-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/circlehub-app-icon.png",
    "scheme": "circlehubmobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/circlehub-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/circlehub-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": false,
      "versionCode": 2,
      "package": "com.nasrdev97.circlehubmobile",
      "googleServicesFile": "./google-services.json"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "always",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6366F1",
          "defaultChannel": "default",
          "largeIcon": "./assets/images/circlehub-app-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/circlehub-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CircleHub to access your photos so you can add them to posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e785b374-5326-4afc-86ef-af5cf6c6772c"
      }
    },
    "owner": "nasrdev97"
  }
}
