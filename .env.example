# Backend base URL for the mobile app.
#
# Copy to `.env` and adjust for your machine. Expo inlines EXPO_PUBLIC_*
# variables at bundle time, so restart the dev server (npx expo start -c) after
# changing this.
#
# Use your LAN IPv4 address — `localhost` and 127.0.0.1 do not reach your
# machine from a physical device. Check it with:
#   Get-NetIPAddress -AddressFamily IPv4
#
# Keep the port on 5289 (plain HTTP). The backend's https profile redirects to
# 7200, which binds to localhost only and uses an untrusted dev certificate.
EXPO_PUBLIC_API_URL=http://192.168.1.2:5289